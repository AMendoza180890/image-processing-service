{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // El front lo empaqueta Vite: resolución estilo bundler (imports sin extensión), DOM + JSX.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["vite/client"]
  },
  "include": ["src", "e2e", "vite.config.ts", "playwright.config.ts"]
}
