# ---------------------------------------------------------------------------
# Copiá este archivo a `.env` y ajustá los valores. NO commitees `.env`.
# ---------------------------------------------------------------------------

# --- Postgres ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=images
POSTGRES_PORT=5432

# Cadena de conexión usada por la API y las migraciones.
# Dentro de docker-compose el host es el NOMBRE DEL SERVICIO `postgres`, no localhost.
DATABASE_URL=postgres://app:app_password@postgres:5432/images

# --- API ---
API_PORT=3000
# Origen permitido para CORS (el front). En dev suele ser http://localhost:8080
CORS_ORIGIN=http://localhost:8080

# --- AWS / LocalStack (Fase 2+) ---
# En local apuntamos el SDK a LocalStack. En AWS real se dejan vacíos/omiten.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Endpoint de LocalStack (nombre de servicio dentro de compose).
AWS_ENDPOINT_URL=http://localstack:4566
S3_BUCKET=images-bucket
# Nombre de la cola (el init de LocalStack la crea con este nombre).
SQS_QUEUE_NAME=images-jobs
SQS_QUEUE_URL=http://localstack:4566/000000000000/images-jobs
# Fuerza path-style addressing para S3 contra LocalStack/MinIO.
S3_FORCE_PATH_STYLE=true
# Endpoint con el que se firman las URLs prefirmadas: el que ve el cliente (host), no `localstack`.
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
# Expiración (segundos) de las URLs prefirmadas de descarga.
PRESIGN_EXPIRES_SECONDS=900
# Tamaño máximo de subida (MB).
MAX_UPLOAD_MB=10

# --- Worker (Fase 2+) ---
WORKER_POLL_WAIT_SECONDS=20
THUMBNAIL_WIDTH=320
WATERMARK_TEXT=procesado

# --- Web (Fase 3) ---
# Puerto del front (Nginx). Si lo cambiás, ajustá CORS_ORIGIN en consecuencia.
WEB_PORT=8080
# Solo para `pnpm --filter @app/web dev`: a dónde reenvía Vite `/api`.
VITE_API_PROXY_TARGET=http://localhost:3000
